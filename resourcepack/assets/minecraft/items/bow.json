{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "index": 0,
      "entries": [
        {
          "threshold": 21,
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": [
                  "gui"
                ],
                "model": {
                  "type": "minecraft:model",
                  "model": "luminara:item/horizen__bow"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "luminara:item/horizen_3d_standby"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/bow"
      }
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.05,
      "entries": [
        {
          "threshold": 0.65,
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:custom_model_data",
            "index": 0,
            "entries": [
              {
                "threshold": 21,
                "model": {
                  "type": "minecraft:select",
                  "property": "minecraft:display_context",
                  "cases": [
                    {
                      "when": [
                        "gui"
                      ],
                      "model": {
                        "type": "minecraft:model",
                        "model": "luminara:item/horizen__bow_pulling_1"
                      }
                    }
                  ],
                  "fallback": {
                    "type": "minecraft:model",
                    "model": "luminara:item/horizen_3d_pulling_1"
                  }
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_1"
            }
          }
        },
        {
          "threshold": 0.9,
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:custom_model_data",
            "index": 0,
            "entries": [
              {
                "threshold": 21,
                "model": {
                  "type": "minecraft:select",
                  "property": "minecraft:display_context",
                  "cases": [
                    {
                      "when": [
                        "gui"
                      ],
                      "model": {
                        "type": "minecraft:model",
                        "model": "luminara:item/horizen__bow_pulling_2"
                      }
                    }
                  ],
                  "fallback": {
                    "type": "minecraft:model",
                    "model": "luminara:item/horizen_3d_pulling_2"
                  }
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_2"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:custom_model_data",
        "index": 0,
        "entries": [
          {
            "threshold": 21,
            "model": {
              "type": "minecraft:select",
              "property": "minecraft:display_context",
              "cases": [
                {
                  "when": [
                    "gui"
                  ],
                  "model": {
                    "type": "minecraft:model",
                    "model": "luminara:item/horizen__bow_pulling_0"
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "luminara:item/horizen_3d_pulling_0"
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow_pulling_0"
        }
      }
    }
  }
}